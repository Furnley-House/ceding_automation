# ─────────────────────────────────────────────────────────
# Furnley House – Ceding Automation Backend Environment
# Copy this to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ceding_automation"

# ── SERVER ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── AUTH / JWT ────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=8h

# ── AZURE OPENAI (Production AI layer) ────────────────────
# These are set up separately per the AI architecture
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ── AZURE AI SPEECH (Fast Transcription for call recordings) ──────────────
# Speech Services resource in UK South. Used by services/ringcentral.ts
# transcribeAudioBuffer for diarized call-recording transcription.
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=uksouth

# ── AZURE BLOB STORAGE ────────────────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=furnleyhouseceding
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key
AZURE_STORAGE_CONTAINER_NAME=ceding-documents

# ── ZOHO CRM ──────────────────────────────────────────────
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_REFRESH_TOKEN=your-zoho-refresh-token
ZOHO_ORG_ID=your-zoho-org-id

# ── ZOHO WORKDRIVE ────────────────────────────────────────
ZOHO_WORKDRIVE_TEAM_ID=your-workdrive-team-id
# Org-wide fallback folder. Used for call-recording uploads always, and for
# Stage 9 case exports when WORKDRIVE_REQUIRE_PER_CLIENT_FOLDER is not "true".
ZOHO_WORKDRIVE_FOLDER_ID=your-default-folder-id
# When "true" (prod), Stage 9 exports hard-fail with 422 if the linked Zoho
# Contact has no Client_Record_Folder_ID populated — forces clean data in CRM
# rather than dumping every client's export into the shared fallback above.
# Leave unset / "false" in staging + local so legacy test cases without the
# Contact field keep using ZOHO_WORKDRIVE_FOLDER_ID.
# WORKDRIVE_REQUIRE_PER_CLIENT_FOLDER=true
# Override the API field name on the Zoho Contact module if your org renamed
# it (Zoho UI relabel only changes the display name, not the API name).
# Default: Client_Record_Folder_ID
# ZOHO_CONTACT_FIELD_WORKDRIVE_FOLDER=Client_Record_Folder_ID

# ── RINGCENTRAL ───────────────────────────────────────────
# 1. Create a Server/Bot app in https://developers.ringcentral.com
# 2. Enable scopes: RingOut, CallLog, ReadCallRecording, ReadAccounts
# 3. Generate a JWT credential in the app's Credentials tab
RINGCENTRAL_CLIENT_ID=your-ringcentral-client-id
RINGCENTRAL_CLIENT_SECRET=your-ringcentral-client-secret
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_JWT=your-jwt-credential-from-rc-developer-portal
# The agent's direct-dial number that will ring first on each outbound call
RINGCENTRAL_AGENT_PHONE=+441234567890

# ── PALINDROME (call transcription) ───────────────────────
# Alternative transcription engine for Stage 5 provider calls, replacing the
# Azure AI Speech path. Palindrome is NOT a request/response API: it sweeps a
# Zoho Creator form for rows flagged "Ready For Processing", reads the audio
# out of a WorkDrive folder shared with its service account, and stamps the
# row when done. See backend/src/services/palindrome.ts.
#
# Feature flag — both engines stay in the codebase, this is the only switch.
TRANSCRIPT_VIA_PALINDROME=false
# Value of the CRM org variable "Palindrome_Production_API_Key".
PALINDROME_API_KEY=your-palindrome-api-key
PALINDROME_API_URL=https://client-service.prod.palindrome.co
# Payload-free "sweep now" trigger. Bound to the workflow that watches the
# Creator form below — change only if Palindrome binds a ceding-specific one.
PALINDROME_TRIGGER_PATH=/api/v1/trigger/post-meeting-workflow
# Palindrome's service account. Only the per-case recordings + transcripts
# subfolders are shared with it, never the whole client record folder.
PALINDROME_ACCESS_EMAIL=palindrome.access@furnleyhouse.co.uk
# Days before that share lapses on its own. 0 = permanent (not recommended).
PALINDROME_SHARE_TTL_DAYS=7
# Creator picklist value. "ceding" makes Palindrome emit a VERBATIM
# transcript_*.docx; "Client - Other" makes it emit a narrated
# superbia_summary_*.docx instead. Verbatim is what checklist extraction
# needs, so keep this as "ceding".
PALINDROME_MEETING_TYPE=ceding

# ── SIGNED RECORDING LINKS ────────────────────────────────
# Palindrome fetches the audio over the public internet from the URL we put
# in the Creator row. A WorkDrive permalink 302s to a login page, and we
# cannot mint a WorkDrive external link (the API user is Editor not
# Organizer — POST /links answers R008) nor should we, since public download
# links are disabled org-wide. So the backend serves the audio itself from
# GET /api/public/recordings/:token — signed, expiring, one file per token.
#
# Signing key. Generate with `openssl rand -hex 32`. Different per
# environment; rotating it revokes every URL already issued.
RECORDING_LINK_SECRET=replace-with-32-byte-hex
# How long each URL stays valid. Palindrome retries 3×, so allow for that.
RECORDING_LINK_TTL_MIN=30
# This backend's externally reachable base URL — Palindrome must be able to
# reach it, so localhost will NOT work. Use the deployed URL, or a tunnel
# host (cloudflared / ngrok) when developing locally.
#   staging: https://ca-cedingai-backend-staging.delightfulpond-8e29b388.uksouth.azurecontainerapps.io
#   prod:    https://ca-cedingai-backend-prod.ambitioushill-a2e27dbd.uksouth.azurecontainerapps.io
PUBLIC_BASE_URL=

# ── ZOHO CREATOR (Palindrome job queue) ───────────────────
# Defaults match the org's live meeting pipeline. We reuse the SAME form on
# purpose: the Palindrome trigger takes no payload, so it can only sweep the
# one form it is bound to — rows on any other form would never be picked up.
# Requires ZohoCreator.form.CREATE + ZohoCreator.report.READ on the refresh
# token; re-run /api/crm/oauth/authorize after changing scopes.
ZOHO_CREATOR_API_BASE=https://www.zohoapis.eu/creator/v2.1
ZOHO_CREATOR_APP_OWNER=zoho_jan116
ZOHO_CREATOR_APP_NAME=meeting-recording-processing
ZOHO_CREATOR_FORM=Meeting_Recordings
ZOHO_CREATOR_REPORT=All_Meeting_Recordings

# ── AZURE AD SSO ─────────────────────────────────────────
# Microsoft Entra ID (Azure AD) — server-side OAuth 2.0 / OIDC flow.
# 1. Register a "Web" platform in your Azure app with redirect URI below.
# 2. Ensure scopes: openid, profile, email (granted under API permissions).
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
# Redirect URI must match exactly what is registered in the Azure app.
AZURE_REDIRECT_URI=http://localhost:3001/api/auth/azure/callback

# ── RATE LIMITING ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ── AI BFF integration (Sprint 2 / B2) ───────────────────
# Feature flag: when "true", document uploads submit to the BFF instead of
# calling Azure OpenAI directly. Default false so the legacy path stays live
# until staging cutover.
AI_VIA_BFF=false
BFF_BASE_URL=https://ca-cedingai-api-staging.delightfulpond-8e29b388.uksouth.azurecontainerapps.io
# X-API-Key sent on every backend → BFF request.
BFF_SHARED_SECRET=DEV_SECRET_CHANGE_IN_PROD
# X-Internal-Key required on BFF → backend write-back PATCH endpoints.
# Generate per environment, e.g. `openssl rand -hex 32`. Must match the value
# stored on the BFF side in kv-cedingai-staging.
INTERNAL_BFF_KEY=replace-with-32-byte-hex