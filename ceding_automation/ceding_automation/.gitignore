# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/

# Environment files - NEVER commit these
.env
.env.local
.env.*.local
# Any copy of a .env is still a .env. A backup made before editing one
# carries every secret the original does, and `.env` alone does not match it.
.env.bak*
.env.backup*
*.env.bak

# Prisma
backend/prisma/migrations/*.sql

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# TypeScript
*.tsbuildinfo

# Claude Code local settings
.claude/

# Uploaded client files - never commit
backend/uploads/

# Accidental directories
{docs,backend

